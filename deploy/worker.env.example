# Example EnvironmentFile for deploy/peakcut-worker.service.
# Copy to a real, non-committed path (e.g. /etc/peakcut/worker.env) and
# fill in real values there — never commit actual secrets to this repo.

# Same SQLite database the web app writes to.
PEAKCUT_DB_PATH=/var/lib/peakcut/peakcut.db

# Where rendered .mp4 exports are written by "render" jobs.
PEAKCUT_EXPORTS_DIR=/var/lib/peakcut/exports

# Where videos fetched by "download" jobs are written. Each download gets
# its own subdirectory here; plan for full-length source videos, not clips.
PEAKCUT_DOWNLOADS_DIR=/var/lib/peakcut/downloads

# Optional: yt-dlp, required by "download" jobs (https://github.com/yt-dlp/yt-dlp).
# Leave unset to resolve "yt-dlp" on PATH. A download job fails honestly
# with "downloader-unavailable" when the binary is missing.
# PEAKCUT_YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional: Netscape-format cookie file, for videos YouTube only serves to a
# signed-in client. Keep it outside the repo and readable only by the worker.
# PEAKCUT_YTDLP_COOKIES=/etc/peakcut/youtube-cookies.txt

# Optional: refuse a source above these limits before downloading any bytes.
# Defaults: 4 h and 4096 MB.
# PEAKCUT_DOWNLOAD_MAX_DURATION_SEC=14400
# PEAKCUT_DOWNLOAD_MAX_MB=4096

# Optional: real transcription providers (see src/lib/transcript/registry.ts).
# Leave unset to only run the offline mock-deterministic provider.
# OPENAI_API_KEY=
# ASSEMBLYAI_API_KEY=

# Optional: real local subject-tracking backend (see
# src/lib/tracking/AutoSubjectDetectionEngine.ts). Leave unset to fall back
# to OpenCV if installed, or fail honestly if neither is available.
# PEAKCUT_TRACKER_COMMAND=
